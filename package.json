{
  "name": "willowbrook-clothing",
  "version": "1.0.0",
  "description": "Willowbrook Clothing - Premium custom apparel platform",
  "scripts": {
    "setup": "node setup.js",
    "auto-setup": "node auto-setup.js",
    "setup-supabase-db": "node setup-supabase-database.js",
    "seed-supabase-db": "node setup-supabase-database.js",
    "test-supabase-connection": "node test-supabase-connection.js",
    "setup-supabase-storage": "node setup-supabase-storage.js",
    "migrate-to-supabase": "node migrate-to-supabase-storage.js",
    "seed-products": "cd server && node seed-products.js",
    "test-deployment": "node test-deployment.js",
    "setup-db": "npm run setup-supabase-db",
    "seed-db": "npm run seed-supabase-db",
    "test-db": "npm run test-supabase-connection",
    "update-images": "node update-product-images.js",
    "rebrand": "node rebrand-to-willowbrook.js",
    "finalize-brand": "node finalize-willowbrook-branding.js",
    "deploy:netlify": "node deploy-to-netlify.js",
    "prepare:netlify": "node deploy-netlify.js",
    "test:netlify": "node test-netlify-setup.js",
    "test:functions": "node test-functions-locally.js",
    "diagnose": "node diagnose-deployment.js",
    "test:login": "node test-login-api.js",
    "validate-supabase": "npm run test-supabase-connection && npm run test:functions",
    "create-admin": "cd server && npm run create-admin",
    "start": "node run-project.js",
    "fix-syntax": "node fix-syntax-error.js",
    "fix-node": "node fix-node-version.js",
    "fix-compatibility": "node fix-compatibility.js",
    "fix-typescript": "node fix-typescript.js",
    "fix-router": "node fix-router-types.js",
    "install-deps": "node install-missing-deps.js",
    "validate-pricing": "node validate-pricing-consistency.js",
    "check-deps": "node check-deps.js",
    "test-setup": "node test-setup.js",
    "test:local-dev": "node test-local-dev.js",
    "reset-password": "node reset-admin-password.js",
    "test-login": "node test-login-local.js",
    "test-routing": "node test-api-routing.js",
    "fix-login": "node quick-fix-login.js",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:netlify\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev:netlify": "node dev-server.js",
    "build": "npm run build:client && npm run build:server",
    "build:netlify": "npm run build:client && npm run build:functions",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "build:functions": "cd netlify/functions && npm install && npm run build",
    "install:all": "npm install && cd client && npm install && cd ../server && npm install"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "jsonwebtoken": "^9.0.2",
    "netlify-cli": "^23.5.1",
    "netlify-lambda": "^2.0.16",
    "pg": "^8.16.3",
    "typescript": "^5.9.2",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  }
}
